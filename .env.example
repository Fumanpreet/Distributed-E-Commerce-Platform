# Copy to .env and fill in. .env is gitignored. Never commit real values.

# AWS (or leave empty to use ~/.aws/credentials / an IAM role)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SQS_ENDPOINT=
INVENTORY_SQS_QUEUE_URL=
INVENTORY_EVENTS_QUEUE_URL=

# inventory-service (Postgres)
INVENTORY_DB_URL=
INVENTORY_DB_USERNAME=
INVENTORY_DB_PASSWORD=changeme

# checkout-service (Postgres)
DB_URL=
DB_USERNAME=
DB_PASSWORD=changeme

# e-commerce-core (Oracle)
CORE_DB_PASSWORD=changeme
CORE_DB_URL=
CORE_DB_USERNAME=
CORE_MONGODB_URI=

# Debezium server
RDS_HOST=
DEBEZIUM_DB_USER=
DEBEZIUM_DB_PASSWORD=changeme
